{
  "name": "@kadmo/n8n-nodes-kadmo",
  "version": "0.1.0",
  "description": "n8n nodes for Kadmo: dispatch jobs, create tasks, run playbooks and react when the work finishes.",
  "license": "MIT",
  "homepage": "https://kadmo.ai",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "kadmo",
    "ai-agents",
    "automation"
  ],
  "author": {
    "name": "kadmo-max",
    "email": "max.svistunov@kadmo.ai",
    "url": "https://kadmo.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kadmo-GmbH/n8n-nodes-kadmo.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/KadmoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Kadmo/Kadmo.node.js",
      "dist/nodes/Kadmo/KadmoTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
